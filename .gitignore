# Python
__pycache__/
*.pyc
.venv/
venv/

# Runtime state: credentials, password hashes, session tokens, the
# per-install secret key, chat history. Never committed, and also excluded
# from the packaged build (see electron/package.json's extraResources).
data/
# ...but the bundled skill templates ship real data files (hash-checked).
!skill_templates/**/data/
# ...and so do the app's static data and its copy in the site demo. Ignored,
# they were force-added file by file, and the demo's bots-ready.json was
# missed: the published demo requested a file that was never committed
# (found 2026-11-01).
!static/data/
!docs/demo/static/data/
.kairos-mobile-runtime/
# Isolated mobile and renderer fixtures, not release source.
kairos-mobile-test-*/
# Test data roots.
ask-user-*/
model-setup-*/
scripts/jarvis-tab-approval-*/
scripts/.test-runtime/

# Secrets
.env
.env.*

# Personal AI-assistant boot pointer (David's own CLAUDE.md/vault setup) —
# local-only. jarvis-app is a public repo; this points at a personal path
# and identity that has no business being published alongside the OSS code.
# Since 2026-10-28 it is AGENTS.local.md: the tracked AGENTS.md files are the
# repository maps, and the root map tells agents to read the local file first.
/AGENTS.local.md
# Launcher that always grants Codex CLI write access to David's personal
# vault path alongside this repo — same personal-path reasoning as above.
codex-jarvis.cmd
# Tailscale-issued TLS cert + private key used by scripts/run_remote.py.
# These are per-machine and must never be committed OR packaged — the
# packaging filter excludes them too.
scripts/*.crt
scripts/*.key
scripts/*.pem

# Build output — electron-builder writes the packaged app here (see
# electron/package.json's "directories.output": "../dist"). Regenerable,
# ~260MB, and it embeds a copy of the backend source.
dist/
electron/dist/

# Dependencies
node_modules/

# Bundled Python runtime — ~400MB of downloaded interpreter + wheels,
# regenerated by scripts/build_runtime.py (which `npm run dist` invokes
# automatically). Build artifact, not source.
electron/runtime/
# Microsoft's vc_redist.x64.exe for the Windows installer, fetched and pinned
# by the same script.
electron/redist/

# Logs
*.log

# Stray output from backgrounded launches during development
nohup.out

# evals: real transcripts and run output never committed (evals/README.md)
evals/**/results/

# Isolated tab tests use a workspace temp root in restricted environments.
scripts/.tab-test-*/
.cli-venv/

# Electron test profiles
.test-tmp/

# Test suites' scratch folders when a cleanup is interrupted (test_computer.py, test_ask_any_model.py)
.computer-test-*/
.ask-any-model-*/
